# Build-time environment variables for local development Vite builds.
# Vite loads this file when running in `development` mode (vite dev, or
# vite build --mode development as used by `npm run dev`).
# These values override .env.production for local dev only. Safe to commit
# because all values here are Cloudflare's published always-pass testkeys.

# Auth0 SPA credentials — same as production for now (dev Auth0 tenant).
VITE_AUTH0_DOMAIN=dev-zy7obc7gqpztqadk.us.auth0.com
VITE_AUTH0_CLIENT_ID=eGHWLKnz44EPGWfmCdcVvYY5SBSMX01B

# Cloudflare Turnstile testkey (always passes; no challenge UI). Pairs with
# the TURNSTILE_SECRET_KEY testkey in .dev.vars.example so the local Worker
# accepts any token the widget emits.
# Docs: https://developers.cloudflare.com/turnstile/troubleshooting/testing/
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
